# Copy to .dev.vars (gitignored) for local `npx wrangler dev`.
DEVICE_TOKEN=dev-token-change-me
ADMIN_TOKEN=dev-admin-change-me
# Real values only needed to test the OAuth flow locally; any string lets
# the Worker boot.
MONZO_CLIENT_ID=oauth2client_dev
MONZO_CLIENT_SECRET=dev-secret
ACCOUNT_ID=acc_dev
WEBHOOK_KEY=dev-webhook-key
# Nag transports unset in dev: nags are skipped when none is configured.
# Production uses BREVO_API_KEY + NAG_FROM + NAG_EMAIL (email) and/or
# NTFY_TOPIC (push) — see wrangler.toml.
