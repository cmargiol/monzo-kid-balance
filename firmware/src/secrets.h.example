// Copy to secrets.h (same directory — it is gitignored) and personalise.
// Without secrets.h the firmware builds in MOCK mode: fixed demo data, and a
// long press on button A cycles the three display states. With WORKER_URL
// defined it builds in LIVE mode: verified-TLS fetch from the Worker, NVS
// cache for instant boot display, long press = refresh now.
#pragma once

// Shown in the balance screen's header. Personal names stay out of the repo.
#define DISPLAY_TITLE "MY MONEY"

// LIVE MODE — uncomment all four ONLY once you have real values. Defining
// WORKER_URL is what switches the build from mock to live, so leaving these
// commented keeps a personalised-title-only secrets.h in mock mode instead of
// fetching a placeholder host forever.
//
// WiFi must be 2.4GHz (the ESP32 has no 5GHz radio). DEVICE_TOKEN is the
// exact value given to `npx wrangler secret put DEVICE_TOKEN`.
// #define WIFI_SSID    "HomeNetwork"
// #define WIFI_PASS    "..."
// #define WORKER_URL   "https://monzo-kid-balance.<your-subdomain>.workers.dev/display"
// #define DEVICE_TOKEN "<device token>"
